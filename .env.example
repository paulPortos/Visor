# Docker Compose configuration. Copy this file to .env at the repository root.
# Native development continues to use server/.env and client/.env.local.

# Required: GitHub OAuth credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth homepage: http://localhost:3000
# OAuth callback: http://localhost:3000/auth/github/callback/

# Google Gemini credentials. Scrum Live defaults to GEMINI_API_KEY if omitted.
GEMINI_API_KEY=
GOOGLE_API_KEY=
SR_DEV_AGENT_MODEL=gemini-2.0-flash
PROJECT_MANAGER_AGENT_MODEL=gemini-2.0-flash

# Leave blank to generate and persist these in the backend_state Docker volume.
# Supply existing values when restoring an existing database.
DJANGO_SECRET_KEY=
GITHUB_TOKEN_ENCRYPTION_KEY=

# Optional overrides.
APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
# Set PUBLIC_URL to the browser-facing origin, without a trailing slash.
# When unset, it defaults to http://localhost:<APP_PORT>.
PUBLIC_URL=
# Optional comma-separated frontend origins, for example when using a Vite dev server.
CORS_ALLOWED_ORIGINS=
DJANGO_DEBUG=False
DJANGO_SESSION_COOKIE_NAME=visor_docker_sessionid
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=visor
POSTGRES_USER=visor
POSTGRES_PASSWORD=visor-local
